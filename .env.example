# Sign in with `codex login` and set HOME below to that private Codex directory.
# Keep auth.json private and outside the repository.
CLASSFORGE_CODEX_EXECUTABLE=codex
CLASSFORGE_CODEX_HOME=
CLASSFORGE_CODEX_MODEL=gpt-6.1-sol
CLASSFORGE_CODEX_TIMEOUT_MILLIS=90000
# Optional deployment overrides:
# CLASSFORGE_MONGODB_URI=mongodb://localhost:27017/classforge?replicaSet=rs0
# CLASSFORGE_ASSISTANT_TEXT_PROVIDER=codex
# CLASSFORGE_ASSISTANT_VISION_PROVIDER=codex
# CLASSFORGE_ASSISTANT_VOICE_PROVIDER=whisper-cpp
