# Private runtime configuration: /etc/classforge/classforge.env (root:root 0600).
# Use plain KEY=value, one variable per line. Do not commit the completed file.
CLASSFORGE_MONGODB_URI=
CLASSFORGE_JWT_SECRET=
CLASSFORGE_WEBSOCKET_ALLOWED_ORIGINS=https://REPLACE_WITH_PUBLIC_HOSTNAME
CLASSFORGE_CODEX_EXECUTABLE=/opt/classforge/bin/codex
CLASSFORGE_CODEX_HOME=/opt/classforge/data/codex
CLASSFORGE_CODEX_MODEL=gpt-6.1-sol
CLASSFORGE_CODEX_TIMEOUT_MILLIS=90000
CLASSFORGE_ASSISTANT_TEXT_PROVIDER=codex
CLASSFORGE_ASSISTANT_VISION_PROVIDER=codex
CLASSFORGE_ASSISTANT_VOICE_PROVIDER=whisper-cpp

# Keep one vision inference per image.
CLASSFORGE_ASSISTANT_VISION_TWO_PASS=false
CLASSFORGE_ASSISTANT_VISION_HYBRID=false

# Optional Web Push. Generate a private VAPID pair; never put the private key in web/APK.
CLASSFORGE_PUSH_ENABLED=false
CLASSFORGE_PUSH_VAPID_PUBLIC_KEY=
CLASSFORGE_PUSH_VAPID_PRIVATE_KEY=
CLASSFORGE_PUSH_VAPID_SUBJECT=https://REPLACE_WITH_PUBLIC_HOSTNAME
